# Read by cmux, which is built on Ghostty and takes its fonts, colours and terminal
# behaviour from this file.

# Font: SF Mono, installed by the homebrew role
font-family = SF Mono
font-size = 14

# Colours: Dayfox, defined in themes/dayfox
theme = dayfox

# Space between the text and the window edge
window-padding-x = 10
window-padding-y = 10

# Hide the mouse pointer while typing
mouse-hide-while-typing = true
