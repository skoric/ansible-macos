# Oh My Zsh (installed by the ohmyzsh role)
export ZSH="$HOME/.oh-my-zsh"
ZSH_THEME="apple"
source "$ZSH/oh-my-zsh.sh"

# mise: use the tool versions (node, java, ...) set for the current directory
eval "$(mise activate zsh)"

# Apply this Mac's setup from anywhere. Extra arguments go to ansible-playbook,
# e.g. `ansible-run --check` or `ansible-run --tags homebrew`.
alias ansible-run='ANSIBLE_CONFIG="$HOME/Development/ansible-macos/ansible.cfg" ansible-playbook "$HOME/Development/ansible-macos/playbook.yml"'

alias che='chezmoi'
alias vim='nvim'

# Load the GitHub SSH key from 1Password into the ssh-agent for 12 hours.
# Asks for the 1Password password. The key is referenced by item ID, so renaming it in 1Password is fine.
ssh-load() {
  local session
  session="$(op signin --raw)" || return
  op read --session "$session" "op://Personal/mvnw7pezlpytyqcgaj6bq7fd64/private key?ssh-format=openssh" | ssh-add -t 12h -
}

# private.yml holds settings that stay out of the public repo. Its copy of record is a
# 1Password document, referenced by ID. Both commands ask for the 1Password password.

# 1Password -> this Mac. Asks before replacing a private.yml that is already there.
private-load() {
  local session
  session="$(op signin --raw)" || return
  op document get 52gwpy3sqyhmfwmxi6inl6k63a --session "$session" --out-file "$HOME/Development/ansible-macos/private.yml"
}

# This Mac -> 1Password. Run it after editing private.yml.
private-save() {
  local session
  session="$(op signin --raw)" || return
  op document edit 52gwpy3sqyhmfwmxi6inl6k63a "$HOME/Development/ansible-macos/private.yml" --session "$session"
}
